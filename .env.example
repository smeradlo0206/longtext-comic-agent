APP_NAME=longtext-comic-agent
DATABASE_URL=postgresql+psycopg://comic_agent:comic_agent_dev@postgres:5432/comic_agent
POSTGRES_USER=comic_agent
POSTGRES_PASSWORD=comic_agent_dev
POSTGRES_DB=comic_agent
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
ENABLE_REAL_LLM=false
LLM_PROVIDER_NAME=ustc-openai-compatible
LLM_BASE_URL=https://api.example/v1
LLM_MODEL=deepseek-v4-pro
LLM_RESPONSE_FORMAT=
LLM_MAX_OUTPUT_TOKENS=3000
LLM_API_KEY=
STORYBIBLE_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=60
RUN_LIVE_LLM_SMOKE_TEST=0

# Internal hosted demo access control. Local demo defaults to no access code.
# Set INTERNAL_DEMO_REQUIRE_ACCESS_CODE=true only for shared hosted demos.
INTERNAL_DEMO_REQUIRE_ACCESS_CODE=false
INTERNAL_DEMO_ACCESS_CODE=
INTERNAL_DEMO_SESSION_TTL_SECONDS=86400
INTERNAL_DEMO_MAX_REAL_EVENT_CHUNKS_PER_RUN=3
INTERNAL_DEMO_MAX_IMPORT_CHARS=20000
