APP_NAME=longtext-comic-agent
WORKSPACE_ROOT=.
IMAGE_QUEUE_ROOT=queue
IMAGE_RUN_ROOT=runs
FLUX_MODEL_PATH=./models/FLUX.2-klein-4B
DATABASE_URL=postgresql+psycopg://comic_agent:comic_agent_dev@postgres:5432/comic_agent
POSTGRES_USER=comic_agent
POSTGRES_PASSWORD=comic_agent_dev
POSTGRES_DB=comic_agent
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
LLM_BASE_URL=https://api.example/v1
LLM_API_KEY=
LLM_THINKING_MODE=disabled
STORYBIBLE_MODEL=deepseek-v4-pro
TIMELINE_MODEL=
TIMELINE_LLM_ENABLED=false
TIMELINE_LLM_TIMEOUT_SECONDS=60
TIMELINE_LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=60
RUN_LIVE_LLM_SMOKE_TEST=0
# GitHub Pages origin only (no repository path), JSON array.
CORS_ORIGINS=["https://YOUR-ACCOUNT.github.io"]
# Server-owned ComicProductionRequestV1 preset; selected assets must exist in its catalog.
PRODUCT_REQUEST_TEMPLATE=configs/longtext-morning-tea.json
