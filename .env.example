APP_NAME=longtext-comic-agent
DATABASE_URL=postgresql+psycopg://comic_agent:comic_agent_dev@postgres:5432/comic_agent
POSTGRES_USER=comic_agent
POSTGRES_PASSWORD=comic_agent_dev
POSTGRES_DB=comic_agent
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Real LLM calls are disabled by default. Enable only for manual campus-network eval.
ENABLE_REAL_LLM=false
LLM_PROVIDER_NAME=ustc-openai-compatible
LLM_BASE_URL=https://api.llm.ustc.edu.cn/v1
LLM_MODEL=deepseek-v4-pro
LLM_RESPONSE_FORMAT=
LLM_TIMEOUT_SECONDS=240
LLM_MAX_OUTPUT_TOKENS=3000
LLM_API_KEY=replace-with-local-key

# Optional only: LLM_RESPONSE_FORMAT=json_object is supported by the provider,
# but it is not recommended for current USTC 3 chunk event eval.

# Internal hosted demo access control. Keep the real code only in local .env.
INTERNAL_DEMO_REQUIRE_ACCESS_CODE=true
INTERNAL_DEMO_ACCESS_CODE=replace-with-internal-demo-code
INTERNAL_DEMO_SESSION_TTL_SECONDS=86400
INTERNAL_DEMO_MAX_REAL_EVENT_CHUNKS_PER_RUN=3
INTERNAL_DEMO_MAX_IMPORT_CHARS=20000
