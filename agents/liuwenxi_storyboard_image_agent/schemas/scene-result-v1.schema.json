        "characters": {
          "items": {
            "$ref": "#/$defs/CharacterVisualStateV1"
          },
          "maxItems": 2,
          "title": "Characters",
          "type": "array"
        },
        "foreground": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Foreground",
          "type": "array"
        },
        "midground": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Midground",
          "type": "array"
        },
        "background": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Background",
          "type": "array"
        },
        "focal_point": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Focal Point",
          "type": "string"
        },
        "environment": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Environment",
          "type": "string"
        },
        "lighting": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Lighting",
          "type": "string"
        },
        "atmosphere": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Atmosphere",
          "type": "string"
        },
        "dialogue_safe_zones": {
          "items": {
            "$ref": "#/$defs/RegionV1"
          },
          "maxItems": 4,
          "title": "Dialogue Safe Zones",
          "type": "array"
        },
        "asset_bindings": {
          "items": {
            "$ref": "#/$defs/AssetBindingV1"
          },
          "maxItems": 3,
          "title": "Asset Bindings",
          "type": "array"
        },
        "required_elements": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Required Elements",
          "type": "array"
        },
        "forbidden_elements": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Forbidden Elements",
          "type": "array"
        }
      },
      "required": [
        "panel_id",
        "narrative_focus",
        "emotional_target",
        "shot_size",
        "camera_angle",
        "camera_direction",
        "focal_point",
        "environment",
        "lighting",
        "atmosphere"
      ],
      "title": "PanelVisualPlanV1",
      "type": "object"
    },
    "ReferenceInputV1": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "identity",
            "scene",
            "style"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "image_index": {
          "maximum": 3,
          "minimum": 1,
          "title": "Image Index",
          "type": "integer"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "target_character_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
