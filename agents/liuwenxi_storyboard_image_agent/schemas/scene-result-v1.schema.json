      "type": "object"
    },
    "RegionV1": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "RegionV1",
      "type": "object"
    },
    "RenderProfile": {
      "enum": [
        "landscape",
        "portrait",
        "square"
      ],
      "title": "RenderProfile",
      "type": "string"
    },
    "SceneErrorV1": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "SceneErrorV1",
      "type": "object"
    },
    "SceneJobStatus": {
      "enum": [
        "SUBMITTED",
        "PLANNING",
        "CONDITIONING",
        "GENERATING",
        "SUCCEEDED",
        "PARTIAL_FAILED",
        "FAILED"
      ],
      "title": "SceneJobStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_name": {
      "const": "SceneResultV1",
      "default": "SceneResultV1",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "chapter_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Chapter Id",
      "type": "string"
    },
    "scene_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Scene Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SceneJobStatus"
    },
    "panels": {
      "items": {
        "$ref": "#/$defs/PanelGenerationResultV1"
      },
      "title": "Panels",
      "type": "array"
    },
    "generation_revision": {
      "const": 1,
      "default": 1,
      "title": "Generation Revision",
      "type": "integer"
    },
    "evaluation_status": {
      "const": "NOT_RUN",
      "default": "NOT_RUN",
      "title": "Evaluation Status",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
