{
  "$defs": {
    "AssetBindingV1": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "identity",
            "scene",
            "style"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "target_character_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Character Id"
        },
        "image_index": {
          "maximum": 3,
          "minimum": 1,
          "title": "Image Index",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "purpose",
        "image_index"
      ],
      "title": "AssetBindingV1",
      "type": "object"
    },
    "CharacterVisualStateV1": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Character Id",
          "type": "string"
        },
        "placement": {
          "enum": [
            "left",
            "center",
            "right",
            "background"
          ],
          "title": "Placement",
          "type": "string"
        },
        "action": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "expression": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "gaze": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Gaze",
          "type": "string"
        }
      },
      "required": [
        "character_id",
        "placement",
        "action",
        "expression",
        "gaze"
      ],
      "title": "CharacterVisualStateV1",
      "type": "object"
    },
    "GenerationSpecV1": {
      "additionalProperties": false,
      "properties": {
        "schema_name": {
          "const": "GenerationSpecV1",
          "default": "GenerationSpecV1",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "panel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Panel Id",
          "type": "string"
        },
        "prompt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Prompt Id",
          "type": "string"
        },
        "positive_prompt": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Positive Prompt",
          "type": "string"
        },
        "negative_prompt": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Negative Prompt",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/ReferenceInputV1"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "References",
          "type": "array"
        },
        "render_profile": {
          "$ref": "#/$defs/RenderProfile"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "steps": {
          "const": 50,
          "default": 50,
          "title": "Steps",
          "type": "integer"
        },
        "true_cfg_scale": {
          "const": 4.0,
          "default": 4.0,
          "title": "True Cfg Scale",
          "type": "number"
        },
        "guidance_scale": {
          "const": 1.0,
          "default": 1.0,
          "title": "Guidance Scale",
          "type": "number"
        },
        "max_sequence_length": {
          "const": 1024,
          "default": 1024,
          "title": "Max Sequence Length",
          "type": "integer"
        },
        "model_id": {
          "const": "Qwen/Qwen-Image-Edit-2509",
          "default": "Qwen/Qwen-Image-Edit-2509",
          "title": "Model Id",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "used_asset_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Used Asset Ids",
          "type": "array"
        },
        "visual_plan_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Visual Plan Version",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "panel_id",
        "prompt_id",
        "positive_prompt",
        "negative_prompt",
        "references",
        "render_profile",
        "width",
        "height",
        "seed",
        "prompt_sha256",
        "used_asset_ids"
      ],
      "title": "GenerationSpecV1",
      "type": "object"
    },
    "PanelArtifactV1": {
      "additionalProperties": false,
      "properties": {
        "image_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Image Id",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "mime_type": {
          "const": "image/png",
          "default": "image/png",
          "title": "Mime Type",
          "type": "string"
        }
      },
      "required": [
        "image_id",
        "uri",
        "url",
        "sha256",
        "width",
        "height"
      ],
      "title": "PanelArtifactV1",
      "type": "object"
    },
    "PanelGenerationMetadataV1": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "title": "Model Revision",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "attempt": {
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "worker_id": {
          "title": "Worker Id",
          "type": "string"
        },
        "gpu_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Gpu Ids",
          "type": "array"
        },
        "generation_seconds": {
          "minimum": 0,
          "title": "Generation Seconds",
          "type": "number"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "model_revision",
        "seed",
        "attempt",
        "worker_id",
        "gpu_ids",
        "generation_seconds",
        "completed_at"
      ],
      "title": "PanelGenerationMetadataV1",
      "type": "object"
    },
    "PanelGenerationResultV1": {
      "additionalProperties": false,
      "properties": {
        "panel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Panel Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PanelJobStatus"
        },
        "visual_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanelVisualPlanV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "generation_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerationSpecV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanelArtifactV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanelGenerationMetadataV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneErrorV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "panel_id",
        "status"
      ],
      "title": "PanelGenerationResultV1",
      "type": "object"
    },
    "PanelJobStatus": {
      "enum": [
        "SUBMITTED",
        "PLANNED",
        "CONDITIONED",
        "GENERATING",
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "PanelJobStatus",
      "type": "string"
    },
    "PanelVisualPlanV1": {
      "additionalProperties": false,
      "properties": {
        "panel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Panel Id",
          "type": "string"
        },
        "narrative_focus": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Narrative Focus",
          "type": "string"
        },
        "emotional_target": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Emotional Target",
          "type": "string"
        },
        "shot_size": {
          "enum": [
            "extreme_wide",
            "wide",
            "medium",
            "close_up",
            "extreme_close_up"
          ],
          "title": "Shot Size",
          "type": "string"
        },
        "camera_angle": {
          "enum": [
            "eye_level",
            "high",
            "low",
            "over_shoulder",
            "top_down",
            "dutch"
