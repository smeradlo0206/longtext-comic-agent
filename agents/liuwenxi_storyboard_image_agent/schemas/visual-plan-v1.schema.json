{
  "$defs": {
    "AssetBindingV1": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "identity",
            "scene",
            "style"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "target_character_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Character Id"
        },
        "image_index": {
          "maximum": 3,
          "minimum": 1,
          "title": "Image Index",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "purpose",
        "image_index"
      ],
      "title": "AssetBindingV1",
      "type": "object"
    },
    "CharacterVisualStateV1": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Character Id",
          "type": "string"
        },
        "placement": {
          "enum": [
            "left",
            "center",
            "right",
            "background"
          ],
          "title": "Placement",
          "type": "string"
        },
        "action": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "expression": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "gaze": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Gaze",
          "type": "string"
        }
      },
      "required": [
        "character_id",
        "placement",
        "action",
        "expression",
        "gaze"
      ],
      "title": "CharacterVisualStateV1",
      "type": "object"
    },
    "PanelVisualPlanV1": {
      "additionalProperties": false,
      "properties": {
        "panel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Panel Id",
          "type": "string"
        },
        "narrative_focus": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Narrative Focus",
          "type": "string"
