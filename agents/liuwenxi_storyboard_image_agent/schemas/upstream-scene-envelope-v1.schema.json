            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "After"
        }
      },
      "required": [
        "subject_id",
        "path",
        "before",
        "after"
      ],
