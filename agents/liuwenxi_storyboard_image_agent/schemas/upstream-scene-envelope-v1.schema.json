{
  "$defs": {
    "RenderProfile": {
      "enum": [
        "landscape",
        "portrait",
        "square"
      ],
      "title": "RenderProfile",
      "type": "string"
    },
    "UpstreamCharacterV1": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Character Id",
          "type": "string"
        },
        "name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "appearance": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Appearance",
          "type": "string"
        },
        "clothing": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Clothing",
          "type": "array"
        }
      },
      "required": [
        "character_id",
        "name",
        "appearance",
        "clothing"
      ],
      "title": "UpstreamCharacterV1",
      "type": "object"
    },
    "UpstreamDialogueV1": {
      "additionalProperties": false,
      "properties": {
        "dialogue_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Dialogue Id",
          "type": "string"
        },
        "speaker_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Speaker Id",
          "type": "string"
        },
        "kind": {
          "default": "speech",
          "enum": [
            "speech",
            "thought",
            "off_screen"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "dialogue_id",
        "speaker_id",
        "text"
      ],
      "title": "UpstreamDialogueV1",
      "type": "object"
    },
    "UpstreamEventV1": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Event Id",
          "type": "string"
        },
        "sequence_no": {
          "minimum": 0,
          "title": "Sequence No",
          "type": "integer"
        },
        "action": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "actor_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Actor Ids",
          "type": "array"
        },
        "target_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Target Ids",
          "type": "array"
        },
        "cause_event_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Cause Event Ids",
          "type": "array"
        },
        "state_changes": {
          "items": {
            "$ref": "#/$defs/UpstreamStateChangeV1"
          },
          "maxItems": 32,
          "title": "State Changes",
          "type": "array"
