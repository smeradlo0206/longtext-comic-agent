    "UpstreamPanelCharacterV1": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Character Id",
          "type": "string"
        },
        "action": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "emotion": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Emotion",
          "type": "string"
        }
      },
      "required": [
        "character_id",
        "action",
        "emotion"
      ],
      "title": "UpstreamPanelCharacterV1",
      "type": "object"
    },
    "UpstreamPanelPlanV1": {
      "additionalProperties": false,
      "properties": {
        "panel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Panel Id",
          "type": "string"
        },
        "sequence_no": {
          "minimum": 0,
          "title": "Sequence No",
          "type": "integer"
        },
        "event_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Event Ids",
          "type": "array"
        },
        "story_intent": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Story Intent",
          "type": "string"
        },
        "characters": {
          "items": {
            "$ref": "#/$defs/UpstreamPanelCharacterV1"
          },
          "maxItems": 2,
          "title": "Characters",
          "type": "array"
        },
        "dialogue": {
          "items": {
            "$ref": "#/$defs/UpstreamDialogueV1"
          },
          "maxItems": 16,
          "title": "Dialogue",
          "type": "array"
        },
        "constraints": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Constraints",
          "type": "array"
        },
        "movement_direction": {
          "anyOf": [
            {
              "enum": [
                "left_to_right",
                "right_to_left",
                "toward_camera",
                "away_from_camera"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Movement Direction"
        },
        "render_profile": {
          "$ref": "#/$defs/RenderProfile",
          "default": "landscape"
        }
      },
      "required": [
        "panel_id",
        "sequence_no",
        "event_ids",
        "story_intent"
